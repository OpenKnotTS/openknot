{
  "name": "@openknot-ts/trpc-fastify",
  "version": "0.0.4-preview",
  "type": "module",
  "description": "tRPC for OpenKnot applications on the Fastify host, through tRPC's official Fastify plugin.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenKnotTS/openknot.git",
    "directory": "openknot-plugs/trpc/trpc-fastify"
  },
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=24.11.0"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "test": "node --expose-gc --test --test-isolation=none test/*.test.ts",
    "prepack": "pnpm build",
    "example": "node examples/trpc.ts"
  },
  "peerDependencies": {
    "@openknot-ts/fastify-server": "workspace:^",
    "@openknot-ts/trpc-context": "workspace:^",
    "@openknot-ts/trpc-router": "workspace:^",
    "@openknot-ts/wire": "workspace:^",
    "@trpc/server": ">=11 <12",
    "fastify": ">=5 <6"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@openknot-ts/behavior": "workspace:*",
    "@openknot-ts/fastify-server": "workspace:*",
    "@openknot-ts/flow": "workspace:*",
    "@openknot-ts/trpc-context": "workspace:*",
    "@openknot-ts/trpc-router": "workspace:*",
    "@openknot-ts/wire": "workspace:*",
    "@trpc/client": "catalog:",
    "@trpc/server": "catalog:",
    "@types/node": "catalog:",
    "@types/ws": "catalog:",
    "fastify": "catalog:",
    "typescript": "catalog:"
  }
}
