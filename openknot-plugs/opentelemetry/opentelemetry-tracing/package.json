{
  "name": "@openknot-ts/opentelemetry-tracing",
  "version": "0.0.4-preview",
  "type": "module",
  "description": "Optional OpenTelemetry API instrumentation for OpenKnot Flow.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenKnotTS/openknot.git",
    "directory": "openknot-plugs/opentelemetry/opentelemetry-tracing"
  },
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=24.11.0"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./wire": {
      "types": "./dist/wire.d.ts",
      "import": "./dist/wire.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "test": "node --expose-gc --test --test-isolation=none test/*.test.ts",
    "example": "node examples/tracing.ts",
    "prepack": "pnpm build"
  },
  "peerDependencies": {
    "@openknot-ts/tracing": "workspace:^",
    "@openknot-ts/wire": "workspace:^",
    "@opentelemetry/api": ">=1.9.0 <2"
  },
  "peerDependenciesMeta": {
    "@openknot-ts/wire": {
      "optional": true
    }
  },
  "devDependencies": {
    "@openknot-ts/behavior": "workspace:*",
    "@openknot-ts/error-reporting": "workspace:*",
    "@openknot-ts/flow": "workspace:*",
    "@openknot-ts/rabbitmq": "workspace:*",
    "@openknot-ts/tracing": "workspace:*",
    "@openknot-ts/wire": "workspace:*",
    "@opentelemetry/api": "catalog:",
    "@opentelemetry/context-async-hooks": "catalog:",
    "@opentelemetry/core": "catalog:",
    "@opentelemetry/sdk-trace": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:"
  }
}
