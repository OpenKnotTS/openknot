{
  "name": "@openknot-ts/auth0-authentication",
  "version": "0.0.2-preview",
  "type": "module",
  "description": "Native tRPC authentication middleware backed by OpenKnot's Auth0 resolver.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenKnotTS/openknot.git",
    "directory": "openknot-plugs/trpc/middleware/auth0-authentication"
  },
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=24.11.0"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "test": "node --test --test-isolation=none test/*.test.ts",
    "prepack": "pnpm build"
  },
  "peerDependencies": {
    "@openknot-ts/flow": "workspace:^",
    "@openknot-ts/trpc-context": "workspace:^",
    "@trpc/server": ">=11 <12"
  },
  "dependencies": {
    "@openknot-ts/auth0-actor": "workspace:*"
  },
  "devDependencies": {
    "@openknot-ts/behavior": "workspace:*",
    "@openknot-ts/flow": "workspace:*",
    "@openknot-ts/knot-http-node": "workspace:*",
    "@openknot-ts/trpc-context": "workspace:*",
    "@openknot-ts/trpc-knot-server-handler": "workspace:*",
    "@openknot-ts/trpc-router": "workspace:*",
    "@openknot-ts/wire": "workspace:*",
    "@trpc/client": "catalog:",
    "@trpc/server": "catalog:",
    "@types/node": "catalog:",
    "@types/ws": "catalog:",
    "jose": "catalog:",
    "typescript": "catalog:",
    "ws": "catalog:"
  }
}
