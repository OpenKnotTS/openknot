{
  "name": "@openknot-ts/knot-health",
  "version": "0.0.4-preview",
  "type": "module",
  "description": "Health probe HTTP adapters for the OpenKnot Node and Fastify hosts, and the probe routing other hosts share.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenKnotTS/openknot.git",
    "directory": "openknot-plugs/knot/knot-health"
  },
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=24.11.0"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./fastify": {
      "types": "./dist/fastify.d.ts",
      "import": "./dist/fastify.js"
    },
    "./probes": {
      "types": "./dist/probes.d.ts",
      "import": "./dist/probes.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "test": "node --test --test-isolation=none test/*.test.ts",
    "prepack": "pnpm build"
  },
  "peerDependencies": {
    "@openknot-ts/fastify-server": "workspace:^",
    "@openknot-ts/health": "workspace:^",
    "@openknot-ts/knot-http-node": "workspace:^",
    "@openknot-ts/wire": "workspace:^",
    "fastify": ">=5 <6"
  },
  "peerDependenciesMeta": {
    "@openknot-ts/fastify-server": {
      "optional": true
    },
    "@openknot-ts/knot-http-node": {
      "optional": true
    },
    "fastify": {
      "optional": true
    }
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@openknot-ts/fastify-server": "workspace:*",
    "@openknot-ts/health": "workspace:*",
    "@openknot-ts/knot-http-node": "workspace:*",
    "@openknot-ts/wire": "workspace:*",
    "@types/node": "catalog:",
    "fastify": "catalog:",
    "typescript": "catalog:"
  }
}
