{
  "name": "@openknot-ts/knot-rest",
  "version": "0.0.2-preview",
  "type": "module",
  "description": "REST routes over OpenKnot exposures, independent of the HTTP host.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenKnotTS/openknot.git",
    "directory": "openknot-plugs/knot/knot-rest"
  },
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=24.11.0"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "test": "node --test --test-isolation=none test/*.test.ts",
    "prepack": "pnpm build"
  },
  "peerDependencies": {
    "@openknot-ts/behavior": "workspace:^",
    "@openknot-ts/flow": "workspace:^",
    "@openknot-ts/tracing": "workspace:^",
    "@openknot-ts/versioning": "workspace:^",
    "@openknot-ts/wire": "workspace:^"
  },
  "dependencies": {
    "@standard-schema/spec": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@openknot-ts/behavior": "workspace:*",
    "@openknot-ts/flow": "workspace:*",
    "@openknot-ts/tracing": "workspace:*",
    "@openknot-ts/versioning": "workspace:*",
    "@openknot-ts/wire": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:"
  }
}
