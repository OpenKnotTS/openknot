{
  "name": "@openknot-ts/knot-rest-http-bun",
  "version": "0.0.4-preview",
  "type": "module",
  "description": "Serves OpenKnot REST routes on the native Bun HTTP host.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenKnotTS/openknot.git",
    "directory": "openknot-plugs/knot/knot-rest-http-bun"
  },
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "bun": ">=1.4.4"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "test": "bun test test",
    "prepack": "pnpm build",
    "example": "bun examples/rest.ts"
  },
  "peerDependencies": {
    "@openknot-ts/error-reporting": "workspace:^",
    "@openknot-ts/knot-http-bun": "workspace:^",
    "@openknot-ts/knot-rest": "workspace:^",
    "@openknot-ts/logging": "workspace:^",
    "@openknot-ts/wire": "workspace:^"
  },
  "devDependencies": {
    "@openknot-ts/behavior": "workspace:*",
    "@openknot-ts/error-reporting": "workspace:*",
    "@openknot-ts/flow": "workspace:*",
    "@openknot-ts/knot-http-bun": "workspace:*",
    "@openknot-ts/knot-rest": "workspace:*",
    "@openknot-ts/logging": "workspace:*",
    "@openknot-ts/wire": "workspace:*",
    "@types/bun": "catalog:",
    "@types/node": "catalog:bun",
    "typescript": "catalog:",
    "zod": "catalog:"
  }
}
