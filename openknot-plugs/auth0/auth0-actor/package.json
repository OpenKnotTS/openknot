{
  "name": "@openknot-ts/auth0-actor",
  "version": "0.1.0",
  "type": "module",
  "description": "Optional Auth0 verified-identity mapping.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenKnotTS/openknot.git",
    "directory": "openknot-plugs/auth0/auth0-actor"
  },
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=24.11.0"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./wire": {
      "types": "./dist/wire.d.ts",
      "import": "./dist/wire.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "test": "node --test --test-isolation=none test/*.test.ts",
    "prepack": "pnpm build"
  },
  "peerDependencies": {
    "@openknot-ts/flow": "workspace:^",
    "@openknot-ts/wire": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@openknot-ts/wire": {
      "optional": true
    }
  },
  "dependencies": {
    "jose": "catalog:"
  },
  "devDependencies": {
    "@openknot-ts/behavior": "workspace:*",
    "@openknot-ts/flow": "workspace:*",
    "@openknot-ts/wire": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:"
  }
}
