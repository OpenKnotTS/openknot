{
  "name": "@openknot-ts/drizzle-uow",
  "version": "0.1.0",
  "type": "module",
  "description": "Drizzle transaction sessions for OpenKnot Unit of Work.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenKnotTS/openknot.git",
    "directory": "openknot-plugs/drizzle/drizzle-uow"
  },
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=24.11.0"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "test": "node --expose-gc --test --test-isolation=none test/*.test.ts",
    "prepack": "pnpm build"
  },
  "peerDependencies": {
    "@openknot-ts/flow": "workspace:^"
  },
  "dependencies": {
    "drizzle-orm": "catalog:"
  },
  "devDependencies": {
    "@openknot-ts/behavior": "workspace:*",
    "@openknot-ts/cache": "workspace:*",
    "@openknot-ts/flow": "workspace:*",
    "@openknot-ts/lock": "workspace:*",
    "@openknot-ts/replication": "workspace:*",
    "@openknot-ts/wire": "workspace:*",
    "@libsql/client": "catalog:",
    "@types/node": "catalog:",
    "mysql2": "catalog:",
    "typescript": "catalog:"
  }
}
