{
  "name": "@openknot-ts/postgres-client",
  "version": "0.0.4-preview",
  "type": "module",
  "description": "PostgreSQL pool resource and health check for OpenKnot applications, over node-postgres.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenKnotTS/openknot.git",
    "directory": "openknot-plugs/postgres/postgres-client"
  },
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=24.11.0"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "test": "node --test --test-isolation=none test/*.test.ts",
    "test:postgres": "node --test --test-isolation=none test/postgres.integration.ts",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@openknot-ts/health": "workspace:*",
    "@openknot-ts/wire": "workspace:*",
    "@types/pg": "catalog:",
    "pg": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:"
  }
}
