{
  "name": "@openknot-ts/flow",
  "version": "0.0.2-preview",
  "type": "module",
  "description": "Typed application handlers, guarded entrypoints and messaging contracts with optional wire integration.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenKnotTS/openknot.git",
    "directory": "openknot-flow"
  },
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=24.11.0"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./wire": {
      "types": "./dist/wire.d.ts",
      "import": "./dist/wire.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "test": "node --expose-gc --test --test-isolation=none test/*.test.ts",
    "example": "node examples/inputs.ts",
    "prepack": "pnpm build",
    "example:publisher": "node examples/publisher.ts",
    "example:handlers": "node examples/handlers.ts",
    "example:topics": "node examples/topics.ts",
    "example:trace": "node examples/trace.ts",
    "example:uow": "node examples/unit-of-work.ts"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "@openknot-ts/behavior": "workspace:*",
    "@openknot-ts/wire": "workspace:*",
    "@openknot-ts/error-reporting": "workspace:*",
    "@openknot-ts/tracing": "workspace:*",
    "@openknot-ts/versioning": "workspace:*",
    "@openknot-ts/logging": "workspace:*"
  },
  "peerDependencies": {
    "@openknot-ts/behavior": "workspace:^",
    "@openknot-ts/error-reporting": "workspace:^",
    "@openknot-ts/tracing": "workspace:^",
    "@openknot-ts/wire": "workspace:^",
    "@openknot-ts/versioning": "workspace:^",
    "@openknot-ts/logging": "workspace:^"
  }
}
