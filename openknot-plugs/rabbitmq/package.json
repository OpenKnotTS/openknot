{
  "name": "@openknot-ts/rabbitmq",
  "version": "0.0.2-preview",
  "type": "module",
  "description": "Managed RabbitMQ topology, publishers and listeners for OpenKnot.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenKnotTS/openknot.git",
    "directory": "openknot-plugs/rabbitmq"
  },
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=24.11.0"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "test:broker": "node --test test/*.integration.ts",
    "example": "node examples/messaging.ts",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@standard-schema/spec": "catalog:",
    "rabbitmq-client": "catalog:",
    "zod": "catalog:",
    "@openknot-ts/health": "workspace:*"
  },
  "peerDependencies": {
    "@openknot-ts/flow": "workspace:^",
    "@openknot-ts/error-reporting": "workspace:^",
    "@openknot-ts/logging": "workspace:^",
    "@openknot-ts/tracing": "workspace:^",
    "@openknot-ts/wire": "workspace:^"
  },
  "devDependencies": {
    "@openknot-ts/behavior": "workspace:*",
    "@openknot-ts/flow": "workspace:*",
    "@openknot-ts/error-reporting": "workspace:*",
    "@openknot-ts/logging": "workspace:*",
    "@openknot-ts/tracing": "workspace:*",
    "@openknot-ts/wire": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:"
  }
}
