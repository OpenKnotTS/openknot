{
  "name": "@openknot-ts/drizzle-versioning",
  "version": "0.0.3-preview",
  "type": "module",
  "description": "Native Drizzle implementation of the OpenKnot versioning contract over a consumer-owned session.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenKnotTS/openknot.git",
    "directory": "openknot-plugs/drizzle/drizzle-versioning"
  },
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=24.11.0"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./wire": {
      "types": "./dist/wire.d.ts",
      "import": "./dist/wire.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "test": "node --test --test-isolation=none test/*.test.ts",
    "test:postgres": "node --test --test-isolation=none test/postgres.integration.ts",
    "prepack": "pnpm build",
    "example": "node examples/sqlite.ts"
  },
  "peerDependencies": {
    "@openknot-ts/versioning": "workspace:^"
  },
  "dependencies": {
    "drizzle-orm": "catalog:"
  },
  "devDependencies": {
    "@openknot-ts/versioning": "workspace:*",
    "@openknot-ts/wire": "workspace:*",
    "@openknot-ts/behavior": "workspace:*",
    "@libsql/client": "catalog:",
    "@types/node": "catalog:",
    "mysql2": "catalog:",
    "typescript": "catalog:",
    "pg": "catalog:",
    "@types/pg": "catalog:"
  }
}
