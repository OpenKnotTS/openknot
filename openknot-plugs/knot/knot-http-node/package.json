{
  "name": "@openknot-ts/knot-http-node",
  "version": "0.0.2-preview",
  "type": "module",
  "description": "Node HTTP server lifecycle and draining for OpenKnot applications.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenKnotTS/openknot.git",
    "directory": "openknot-plugs/knot/knot-http-node"
  },
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=24.11.0"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./handler": {
      "types": "./dist/handler.d.ts",
      "import": "./dist/handler.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "test": "node --test --test-isolation=none test/*.test.ts",
    "prepack": "pnpm build",
    "example": "node examples/http.ts"
  },
  "peerDependencies": {
    "@openknot-ts/wire": "workspace:^"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@openknot-ts/wire": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:"
  }
}
