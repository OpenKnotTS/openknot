{
  "name": "@openknot-ts/sentry-bun",
  "version": "0.0.3-preview",
  "type": "module",
  "description": "Reports OpenKnot failures to Sentry through the Bun SDK, with its lifecycle.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenKnotTS/openknot.git",
    "directory": "openknot-plugs/sentry/sentry-bun"
  },
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "bun": ">=1.4.4"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "test": "bun test test",
    "prepack": "pnpm build"
  },
  "peerDependencies": {
    "@openknot-ts/sentry": "workspace:^",
    "@openknot-ts/wire": "workspace:^",
    "@sentry/bun": ">=11.12.0 <12"
  },
  "devDependencies": {
    "@openknot-ts/behavior": "workspace:*",
    "@openknot-ts/error-reporting": "workspace:*",
    "@openknot-ts/flow": "workspace:*",
    "@openknot-ts/sentry": "workspace:*",
    "@openknot-ts/wire": "workspace:*",
    "@sentry/bun": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:bun",
    "typescript": "catalog:",
    "zod": "catalog:"
  }
}
