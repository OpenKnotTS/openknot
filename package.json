{
  "name": "openknot",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "format": "oxfmt",
    "lint": "oxlint",
    "check": "oxfmt --check && oxlint && pnpm build && pnpm -r --if-present check",
    "test": "pnpm build && pnpm -r --if-present test",
    "test:e2e": "pnpm build && pnpm --filter @modular/container test:e2e",
    "test:postgres": "pnpm build && pnpm -r --if-present test:postgres",
    "test:broker": "pnpm build && pnpm -r --if-present test:broker",
    "test:redis": "pnpm build && pnpm -r --if-present test:redis",
    "example:quickstart": "pnpm build && pnpm --filter @quick-start/app start",
    "example:modular": "pnpm build && pnpm --filter @modular/container start"
  },
  "devDependencies": {
    "oxfmt": "catalog:",
    "oxlint": "catalog:"
  }
}
